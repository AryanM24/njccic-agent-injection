# secrets / local env -- every .env variant except the committed template
.env
.env.*
!.env.example

# python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/

# inspect eval logs
logs/

# gated: canonical (real-payload) corpus never leaves the workstation.
# The directory itself is tracked via .gitkeep so the layout is reproducible.
corpus/canonical/*
!corpus/canonical/.gitkeep

# gated: real concealment payloads (future file, must never be committed)
src/eduinject/corpus/payloads.py

# local sandbox scratch
test_sandbox/

# local git worktrees for isolated implementation work
.worktrees/
# macOS Finder metadata
.DS_Store

# Superseded local draft of the paper, kept on disk only
paper/_previous_draft/

# Node packages for the presentation and poster builds
node_modules/
